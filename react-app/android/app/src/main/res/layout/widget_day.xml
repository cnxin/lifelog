<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp"
    android:background="@drawable/widget_day_rose">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_day_empty" android:maxLines="1" android:ellipsize="end"
        android:textSize="14sp" android:textColor="#303530" android:fontFamily="sans-serif-medium" />
    <LinearLayout android:id="@+id/widget_number_row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_prefix" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#303530" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/widget_count" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="32sp" android:textColor="#465b45" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        <TextView android:id="@+id/widget_suffix" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#303530" android:layout_marginStart="2dp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_day_open" android:textSize="11sp" android:textColor="#303530"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="6dp" />
</LinearLayout>
