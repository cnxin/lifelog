{
  "name": "lifelog-react-app",
  "private": true,
  "version": "0.1.0-test.97",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "test:parser": "node scripts/test-place-share-parser.cjs",
    "test:helpers": "node scripts/test-lifelog-save-helpers.cjs",
    "test:quick-memory": "node scripts/test-quick-memory-context.cjs",
    "test:release-notes": "node scripts/test-release-notes.cjs",
    "test:update-checker": "node scripts/test-update-checker.cjs",
    "test:calendar-items": "node scripts/test-calendar-items.cjs",
    "test:diagnostics": "node scripts/test-diagnostics.cjs",
    "test:backup-health": "node scripts/test-backup-health.cjs",
    "test:backup-import": "node scripts/test-backup-import.cjs",
    "test:external-links": "node scripts/test-external-links.cjs",
    "test:release-ready": "node scripts/verify-release-ready.cjs",
    "test:reminders": "node scripts/test-reminder-preview.cjs",
    "test:memory": "node scripts/test-memory-inference.cjs",
    "test:display": "node scripts/test-memory-display.cjs",
    "test:location": "node scripts/test-place-location-filter.cjs",
    "preview": "vite preview",
